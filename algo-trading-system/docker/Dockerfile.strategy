# ============================================================
# Strategy Engine — L4/L6 NautilusTrader + Risk + Execution
# ============================================================
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg ca-certificates && rm -rf /var/lib/apt/lists/*

# NautilusTrader + Python deps
RUN pip install --no-cache-dir nautilustrader==1.209.0

# Copy source
COPY common/ /app/common/
COPY strategies/ /app/strategies/
COPY execution/ /app/execution/
COPY risk/ /app/risk/
COPY data/ /app/data/

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD python -c "import strategies; print('healthy')" || exit 1

CMD ["python", "-m", "strategies.engine"]