# ============================================================
# Research Service — L3 ML/DL Training + Backtesting
# ============================================================
FROM python:3.11-slim

WORKDIR /app

# System deps for GPU / CUDA (optional)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gnupg ca-certificates \
    && curl -fsSL https://developer.download.nvidia.com/compute/cuda/repos/debian/x86_64/cuda-keyring_1.0-1_all.deb \
    -o /tmp/cuda-keyring.deb && dpkg -i /tmp/cuda-keyring.deb && rm /tmp/cuda-keyring.deb \
    && apt-get update && apt-get install -y cuda-toolkit \
    && rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip install --no-cache-dir torch torchvision torchaudio \
    && pip install --no-cache-dir onnxruntime

# Copy source
COPY common/ /app/common/
COPY ingestion/ /app/ingestion/
COPY research/ /app/research/
COPY strategies/ /app/strategies/
COPY data/ /app/data/
COPY models/ /app/models/

HEALTHCHECK --interval=60s --timeout=15s --retries=3 \
    CMD python -c "import research; print('healthy')" || exit 1

CMD ["jupyter", "lab", "--ip=0.0.0.0", "--port=8888", "--no-browser", "--allow-root"]