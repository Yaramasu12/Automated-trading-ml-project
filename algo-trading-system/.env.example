# ============================================================
# Algo-Trading-System Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ---- Trading Mode (NON-NEGOTIABLE) ----
# MODE=paper   → Paper/simulated trading (DEFAULT, SAFE)
# MODE=live    → LIVE trading (DANGEROUS — requires CONFIRM_LIVE)
MODE=paper

# ---- Live Trading Gate (REQUIRED when MODE=live) ----
# Must be set to this exact value to enable live trading
CONFIRM_LIVE=I_UNDERSTAND

# ---- Global Kill Switch ----
# Set to "false" to instantly halt all trading
KILL_SWITCH_ENABLED=false

# ---- Database: PostgreSQL (metadata, config, audit) ----
POSTGRES_USER=algo_trader
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
POSTGRES_DB=algo_meta
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Database: TimescaleDB (time-series, PnL, metrics) ----
TIMESCALE_USER=algo_timescale
TIMESCALE_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
TIMESCALE_DB=algo_timeseries
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432

# ---- Database: ClickHouse (tick/L2 data) ----
CLICKHOUSE_USER=algo_click
CLICKHOUSE_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
CLICKHOUSE_DB=algo_ticks
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123

# ---- Database: Redis (hot state, cache) ----
REDIS_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Database: MinIO (Parquet data lake) ----
MINIO_ROOT_USER=algo_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_API_PORT=9000

# ---- Database: Qdrant (vector DB for RAG) ----
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ---- Redpanda (Kafka-compatible event bus) ----
REDPANDA_HOST=redpanda
REDPANDA_PORT=9092

# ---- Market Data Vendors ----
# Databento
DATABENTO_KEY=your_databento_api_key_here
DATABENTO_PROFILE=default

# Polygon
POLYGON_API_KEY=your_polygon_api_key_here

# IBKR (Interactive Brokers)
IBKR_GW_HOST=ib-gateway
IBKR_GW_PORT=4001
IBKR_TRADING=paper
IBKR_APP_PORT=7497
IBKR_API_PORT=7496

# Crypto venue
CRYPTO_EXCHANGE_KEY=your_crypto_exchange_key_here
CRYPTO_EXCHANGE_SECRET=your_crypto_exchange_secret_here

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE=postgresql+psycopg2://algo_trader:CHANGE_ME@postgres:5432/mlflow
MLFLOW_ARTIFACT_STORAGE=http://minio:9000/mlflow-artifacts

# ---- Prometheus & Grafana ----
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090
GRAFANA_HOST=grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---- Alerting ----
ALERTMANAGER_WEBHOOK_URL=your_alertmanager_webhook_url
SENTRY_DSN=your_sentry_dsn_here

# ---- Prefect (orchestration) ----
PREFECT_SERVER_URL=http://prefect:4200
PREFECT_API_KEY=your_prefect_api_key

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---- Strategy Defaults ----
DEFAULT_STRATEGY=ma_crossover
UNIVERSE_SIZE=50
REBALANCE_INTERVAL_SEC=60

# ---- Risk Limits (config-driven, can be overridden) ----
MAX_ORDER_SIZE=100
MAX_NOTIONAL_PER_TRADE=50000
MAX_GROSS_EXPOSURE=1.0
MAX_LEVERAGE=1.0
MAX_ORDERS_PER_SECOND=10
DAILY_DRAWDOWN_LIMIT_PCT=2.0
MAX_DRAWDOWN_LIMIT_PCT=5.0

# ---- Feature Store ----
FEATURE_STORE_PATH=/data/features

# ---- Data Paths ----
DATA_LAKE_PATH=/data/lake
HISTORICAL_DATA_PATH=/data/historical